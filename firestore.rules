rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email == "dingzhou02@gmail.com";
    }

    function isAdmin() {
      return isSignedIn() && (
        isOwner() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active"
        ) ||
        (
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)) &&
          get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.role == "admin" &&
          get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.status == "active"
        )
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isOwner() ||
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active"
        ) ||
        (
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)) &&
          get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.status == "active"
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins collection
    match /admins/{userId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Whitelisted operator emails
    match /allowedEmails/{email} {
      allow read: if isSignedIn() && (isStaff() || request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // Roles & permissions collection
    match /roles/{roleId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Users (staff / operators) collection
    match /users/{userId} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdmin() || (isOwner() && request.auth.uid == userId);
      allow update: if isAdmin() || (
        isStaff() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );
      allow delete: if isAdmin();
    }

    // Chunked cloud file storage for PDFs and high-res photos
    match /fileChunks/{chunkId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isValidId(chunkId);
      allow delete: if isStaff();
    }

    // Customers collection
    match /customers/{customerId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidId(customerId);
      allow update: if isStaff() && isValidId(customerId);
      allow delete: if isStaff();
    }

    // Measurements collection
    match /measurements/{measurementId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidId(measurementId);
      allow update: if isStaff() && isValidId(measurementId);
      allow delete: if isStaff();
    }

    // Materials and inventory
    match /materials/{materialId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isValidId(materialId);
      allow delete: if isStaff();
    }

    match /inventoryTransactions/{transactionId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidId(transactionId);
      allow update, delete: if false; // Inventory log is strictly immutable
    }

    // Styles catalog
    match /styles/{styleId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isValidId(styleId);
      allow delete: if isStaff();
    }

    // Orders and OrderItems
    match /orders/{orderId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isValidId(orderId);
      allow delete: if isStaff();
    }

    match /orderItems/{itemId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isValidId(itemId);
      allow delete: if isStaff();
    }

    match /orderPayments/{paymentId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidId(paymentId);
      allow update, delete: if false; // Payment ledger is immutable
    }

    // Wallets and WalletTransactions
    match /wallets/{customerId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isValidId(customerId);
      allow delete: if false;
    }

    match /walletTransactions/{transactionId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidId(transactionId);
      allow update, delete: if false; // Financial ledger is strictly immutable
    }

    match /paymentOrders/{paymentOrderId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isValidId(paymentOrderId);
      allow delete: if false;
    }

    // Customer Archives and Images
    match /customerFiles/{fileId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidId(fileId);
      allow update: if isStaff() && isValidId(fileId);
      allow delete: if isStaff();
    }

    match /customerImages/{imageId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidId(imageId);
      allow update: if isStaff() && isValidId(imageId);
      allow delete: if isStaff();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isAdmin() || isStaff();
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidId(logId);
      allow update, delete: if false; // Audit trail is strictly immutable
    }
  }
}
