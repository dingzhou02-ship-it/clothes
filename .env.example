# Environment Variables
GEMINI_API_KEY=

# Optional Firebase Client Configuration Overrides (for custom Netlify deployments; defaults to firebase-applet-config.json)
# Note: Never place Admin SDK private keys, service account JSON, or bootstrap passwords in VITE_ client variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

